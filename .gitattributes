# Auto-detect text files and normalise line endings to LF in the repo
* text=auto

# Explicitly set batch files to CRLF on checkout (Windows requirement)
*.bat text eol=crlf

# Force LF for all other source files
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
